<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Password Login</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <main class="shell narrow">
    <section class="panel">
      <h1>Standard sign-in</h1>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="/login/password" class="stack">
        <label>Username or email <input name="username" required></label>
        <label>Password <input name="password" type="password" required></label>
        <button class="button" type="submit">Sign in</button>
      </form>
      <div class="actions">
        <a class="button ghost" href="/login/passkey">Secure sign-in</a>
        <a class="button ghost" href="/register">Create account</a>
      </div>
    </section>
  </main>
</body>
</html>
